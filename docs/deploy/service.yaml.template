apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: meetups-backend
spec:
  template:
    metadata:
      # Explicit revision name. `services replace` only creates a new
      # revision when the template CHANGES — with an unchanged spec it
      # re-points at the existing (here: failed) revision and reports
      # failure without starting a container. Bump this suffix on any
      # redeploy that does not otherwise change the spec.
      name: meetups-backend-r22
      annotations:
        # Instance ceiling, derived from the DATABASE rather than from
        # traffic. db.MaxConns is 20 per instance, and the database is
        # Supabase's transaction pooler (ADR-007, runbook §6), which admits
        # 200 client connections and multiplexes them onto about 15 server
        # connections. Cloud Run's default of 100 instances would therefore
        # demand up to 2000 client connections and the pooler would start
        # REFUSING them at instance 10 — a hard failure, not a slowdown, and
        # nothing in the app guards against it.
        #
        # 8 x 20 = 160 leaves 40 under the pooler's 200 (thinner than the
        # old Cloud SQL margin, so re-do this arithmetic before raising
        # either number). It is also a spend ceiling: a retry loop or
        # traffic spike cannot scale to 100 instances and bill for them.
        # Raise it only together with a smaller MaxConns or a paid Supabase
        # tier with a higher pooler limit.
        autoscaling.knative.dev/maxScale: "8"
        # ONE RESERVED INSTANCE, AND CPU THAT IS ALWAYS THERE.
        #
        # Changed from "0" on 2026-10-21 (tracker #77, review N-C1). The
        # cost reasoning below still holds and is still the reason this is
        # 1 and not 2; what it missed is that this service is not only a
        # request handler. It runs background loops: the notification
        # outbox poller, the lifecycle poller (reminders, auto-close), the
        # user-deleted purge and the retention sweeps.
        #
        # Cloud Run gives an idle instance NO CPU unless cpu-throttling is
        # off, and at minScale 0 there is no instance at all between
        # requests. Both together meant those loops ran only while someone
        # happened to be using the app: reminders fired late or not at
        # all, auto-close left meetups open past their window, and the
        # account-deletion purge — which has a legal deadline — had an
        # unbounded one.
        #
        # The driver for those loops is Cloud Scheduler, NOT a reserved
        # instance: one always-free job calls POST /internal/cron/tick,
        # which runs every sweep once. See cmd/monolith/cron.go and §10 of
        # the runbook.
        #
        # Keep this at "0". It is a cost guarantee, not a tuning knob:
        # this project must stay inside Cloud Run's always-free tier
        # (Shashika, 2026-10-22). At "1" a reserved instance bills
        # continuously, and adding cpu-throttling "false" bills its CPU at
        # the always-allocated rate — together about US$120-130/mo for
        # this 2 vCPU / 1.5 GiB pair, against a free allowance of 180k
        # vCPU-seconds a month. cmd/monolith/deploy_manifest_test.go
        # fails if either creeps back.
        #
        # The cost of "0" is a cold start for the first caller after an
        # idle gap (measured 6.2s cold vs 0.27s warm); anyone arriving
        # inside that window is SHED by Cloud Run with a plain-text 429
        # "no available instance". That reads like rate limiting and is
        # not — this app's own limiter answers {"error":"rate limited"}
        # with a Retry-After header. See §7 of the runbook.
        #
        # Keep this value IN THIS FILE. Applying it with
        # `gcloud run services update --min-instances=N` alone leaves a
        # manifest that silently reverts it on the next
        # `services replace`.
        autoscaling.knative.dev/minScale: "0"
        run.googleapis.com/cloudsql-instances: project-285b9289-549d-4fef-92c:asia-south1:meetups-db
        run.googleapis.com/container-dependencies: '{"gateway":["monolith"]}'
    spec:
      containers:
      - name: gateway
        image: asia-south1-docker.pkg.dev/project-285b9289-549d-4fef-92c/meetups-repo/gateway:r22
        ports:
        - containerPort: 8080
        env:
        # PORT is deliberately absent: Cloud Run reserves it and injects it
        # automatically from containerPort (8080 above). Declaring it is a
        # hard deploy error, not an override.
        - name: MONOLITH_ADDR
          value: "localhost:9090"
        - name: JWT_PRIVATE_KEY_PATH
          value: /secrets-priv/jwt_private.pem
        - name: JWT_PUBLIC_KEY_PATH
          value: /secrets-pub/jwt_public.pem
        - name: MONOLITH_SHARED_SECRET
          valueFrom:
            secretKeyRef: { name: internal-grpc-secret, key: latest }
        # The real client is the LAST X-Forwarded-For entry, which Cloud Run's
        # proxy appends. Without this the rate limiter keys every user on
        # that proxy's address: one shared bucket per route for the whole
        # user base (#81). See middleware.WithTrustedProxyHops.
        - name: TRUSTED_PROXY_HOPS
          value: "1"
        resources:
          limits: { memory: 512Mi, cpu: "1" }
        volumeMounts:
        - { name: jwt-priv, mountPath: /secrets-priv }
        - { name: jwt-pub, mountPath: /secrets-pub }
        startupProbe:
          # tcpSocket rather than httpGet /healthz.
          #
          # Note on /healthz, since it is surprising: Google's frontend
          # intercepts GET /healthz on *.run.app and returns its own 404 —
          # the request never reaches the container. Verified: the app
          # answers /healthz 200 locally, and Cloud Run's own request log
          # shows /readyz and /metrics arriving but /healthz never appearing
          # at all. This is NOT caused by the probe (it still happened with
          # the httpGet probe removed) and is not fixable from here. Use
          # /readyz for external health checks — it is the stronger signal
          # anyway, since it verifies the gateway can reach the monolith.
          #
          # tcpSocket is adequate for startup: the gateway binds its
          # listener only after the signer, verifier and monolith client
          # are constructed, and container-dependencies already holds it
          # until the monolith is up.
          tcpSocket: { port: 8080 }
          periodSeconds: 3
          failureThreshold: 10
      - name: monolith
        image: asia-south1-docker.pkg.dev/project-285b9289-549d-4fef-92c/meetups-repo/monolith:r22
        env:
        - name: MONOLITH_PORT
          value: "9090"
        # Where the link texted to a new trusted contact points (#80): the
        # gateway's public URL, which serves the confirmation page at /c/.
        # Unset, it defaults to http://localhost:8080 for local stacks, and
        # every production invitation would be a dead link.
        - name: PUBLIC_BASE_URL
          value: "<SERVICE_URL>"
        # REQUIRED at startup, not optional. The plan doc claims these are
        # "deliberately omitted ... fail closed rather than blocking
        # startup" — that is wrong: internal/modules/auth/config/config.go
        # has a hard required list, and the monolith exits 1 without them.
        # The expected `aud` on each provider's id_token. Public client
        # identifiers, not secrets — same category as LINKEDIN_CLIENT_ID.
        #
        # REQUIRED for Apple/Google sign-in to work at all. They were missing
        # from this template until 2026-09-25, so the deployed service had
        # them unset while backend/.env had them locally: Google sign-in
        # worked on a developer machine and failed in production, with no
        # startup error to point at it. identity.NewGoogleProvider and
        # NewAppleProvider accept "" so the service can boot before the
        # credential exists, and then reject every token that arrives.
        #
        # GOOGLE_CLIENT_ID is the WEB OAuth client, NOT the Android or iOS
        # one: google_sign_in's serverClientId makes every platform mint a
        # token with this single audience. It must equal frontend/.env's
        # GOOGLE_SERVER_CLIENT_ID exactly, or every sign-in fails the aud
        # check. APPLE_SERVICES_ID is the app's bundle id for native Sign in
        # with Apple.
        - name: GOOGLE_CLIENT_ID
          value: "<GOOGLE_CLIENT_ID>"
        - name: APPLE_SERVICES_ID
          value: "<APPLE_SERVICES_ID>"
        - name: LINKEDIN_CLIENT_ID
          value: "<LINKEDIN_CLIENT_ID>"
        - name: LINKEDIN_REDIRECT_URI
          value: "https://professional-meetups-976d2.web.app"
        - name: LINKEDIN_CLIENT_SECRET
          valueFrom: { secretKeyRef: { name: linkedin-client-secret, key: latest } }
        - name: DATABASE_URL
          valueFrom: { secretKeyRef: { name: database-url, key: latest } }
        - name: INTERNAL_GRPC_SHARED_SECRET
          valueFrom: { secretKeyRef: { name: internal-grpc-secret, key: latest } }
        - name: FIREBASE_SERVICE_ACCOUNT_JSON
          valueFrom: { secretKeyRef: { name: firebase-sa, key: latest } }
        - name: TWILIO_ACCOUNT_SID
          value: "<TWILIO_ACCOUNT_SID>"
        - name: TWILIO_PHONE_NUMBER
          value: "<TWILIO_PHONE_NUMBER>"
        - name: TWILIO_AUTH_TOKEN
          valueFrom: { secretKeyRef: { name: twilio-auth-token, key: latest } }
        # Gmail SMTP for verification emails. Without both of these the
        # monolith falls back to LoggingEmailSender, which only writes the
        # code to the logs — and personal-email verification is one of the
        # four things Level 2 requires (trustlevel.go), so Level 2 was
        # unreachable from the app until this was set.
        - name: GMAIL_ADDRESS
          value: "<GMAIL_ADDRESS>"
        - name: GMAIL_APP_PASSWORD
          valueFrom: { secretKeyRef: { name: gmail-app-password, key: latest } }
        - name: WORK_EMAIL_HMAC_KEY_PATH
          value: /secrets-hmac/work_email_hmac.key
        - name: ALLOW_TEST_OTP_BYPASS
          value: "false"
        # The narrower, scoped bypass (Plan 16/17). ALLOW_TEST_OTP_BYPASS
        # above stays "false" — it is global, and this URL is public.
        # This one is phone-purpose-only and limited to these exact numbers,
        # matched byte-for-byte against what the client sends. Plain env,
        # not a secret: these are phone numbers, not credentials.
        # Revert = delete these two lines, bump the revision, redeploy.
        - name: TEST_OTP_BYPASS_PHONES
          value: "<TEST_OTP_BYPASS_PHONES>"
        # The email twin (see otp.go's "THE THIRD MECHANISM"). Same shape,
        # different justification: email delivery WORKS, so unlike the phone
        # list this does expose accounts that would otherwise be reachable
        # only with a real code.
        #
        # What makes that acceptable is the contents, not the mechanism:
        # every entry is on .test, an RFC 2606 reserved TLD that cannot be
        # registered and cannot receive mail, so none of these can ever be a
        # real person's address. They map 1:1 onto the eight seeded fixtures
        # in testdata/seed-test-users.sql (two per trust level 0-3).
        #
        # NEVER add a deliverable address here. An allowlisted address is a
        # published credential for whoever knows it.
        #
        # Revert = delete these two lines, bump the revision, redeploy.
        - name: TEST_OTP_BYPASS_EMAILS
          value: "<TEST_OTP_BYPASS_EMAILS>"
        resources:
          limits: { memory: 1Gi, cpu: "1" }
        volumeMounts:
        - { name: work-hmac, mountPath: /secrets-hmac }
        startupProbe:
          # tcpSocket, NOT grpc: the health service sits behind the same
          # internalauth interceptor as every business RPC, deliberately
          # (see cmd/monolith/healthcheck.go's comment — "an exemption list
          # is a place for mistakes"). Cloud Run's grpc prober sends no
          # credential, so it got UNAUTHENTICATED 20 times and the instance
          # never started. `monolith -healthcheck` is the only prober that
          # can authenticate, and Cloud Run has no exec probe.
          #
          # This is an accurate readiness signal regardless: the listener is
          # bound only after the DB pool, Twilio and FCM are wired, and
          # SERVING is set microseconds later in the same function. The port
          # opening genuinely means the monolith is up.
          tcpSocket: { port: 9090 }
          periodSeconds: 3
          failureThreshold: 20
      volumes:
      - name: jwt-priv
        secret: { secretName: jwt-private-key, items: [{ key: latest, path: jwt_private.pem }] }
      - name: jwt-pub
        secret: { secretName: jwt-public-key, items: [{ key: latest, path: jwt_public.pem }] }
      - name: work-hmac
        secret: { secretName: work-email-hmac, items: [{ key: latest, path: work_email_hmac.key }] }
