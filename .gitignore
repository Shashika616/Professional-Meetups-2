# Go
/backend/**/*.exe
/backend/**/bin/
/backend/**/*.out
/backend/**/vendor/

# Secrets — generate your own per backend/secrets/README.md, never commit
/backend/secrets/*.pem
/backend/secrets/*.key
/backend/.env
!/backend/secrets/.gitkeep
!/backend/secrets/README.md

# Flutter/Dart (mirrors frontend/.gitignore, root-level safety net)
frontend/.dart_tool/
frontend/build/
frontend/coverage/
frontend/.pub-cache/
frontend/.pub/
frontend/.env

# OS/editor
.DS_Store
.vscode/
.idea/
