# Copy to `.env` (gitignored — see ../.gitignore) and fill in. docker-compose
# reads this automatically from the same directory (backend/). Never commit
# the real .env.
#
# This only lists what Phase 1 (auth module) actually wires in
# docker-compose.yml today — see docs/plans/00-overview.md. Meetup/billing/
# notification vars (e.g. FIREBASE_SERVICE_ACCOUNT_JSON,
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON) get added here when those phases actually
# wire them into docker-compose.yml, not before.
#
# JWT signing/verification keys and the work-email HMAC key are NOT env
# vars — they're files under backend/secrets/, mounted read-only into the
# containers. See backend/secrets/README.md for how to generate them.

POSTGRES_USER=app
POSTGRES_PASSWORD=app

# From LinkedIn Developer Portal (https://www.linkedin.com/developers/apps) —
# same app/credentials/redirect-URL setup as the sibling microservices repo's
# backend/.env.example describes in full detail; copy its LINKEDIN_* section
# if you're setting this up for the first time and want the complete
# walkthrough (auth-bridge URL requirement, exact-match redirect rules, etc.).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://<your-project-id>.web.app

# Sign in with Apple / Google Sign-In audiences (ADR-014 in the sibling
# repo, ported here as auth-module business logic). Leave both empty for
# local dev/tests — those identity providers fail closed (reject every
# token) rather than block startup when unset.
APPLE_SERVICES_ID=
GOOGLE_CLIENT_ID=

# Phone OTP delivery — plain Twilio Programmable Messaging API. Leave empty
# for local dev/tests; falls back to a logging sender (logs the code
# instead of sending).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Personal/corporate/signup email OTP delivery. Gmail SMTP (preferred for
# testing — can send to any recipient, no sandbox restriction) takes
# priority over Resend when both are set. Leave all four empty for local
# dev/tests; falls back to a logging sender, same as SMS above.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Authenticates the gateway->monolith gRPC hop (ADR-001's 2026-09-04
# correction). Every monolith RPC trusts its caller's user_id, which is only
# safe if the gateway is the sole caller; until this existed, that rested
# purely on Docker network isolation rather than on anything the code
# enforced. The two variables below MUST hold the same value — the monolith
# verifies what the gateway sends. docker-compose.yml feeds both from this
# one .env entry so they cannot drift.
#
# Both are REQUIRED: neither process starts without it, and there is
# deliberately no "unset means skip the check" fallback.
#
# Generate a fresh one (never reuse the sibling repo's, or this example's):
#   openssl rand -base64 32
INTERNAL_GRPC_SHARED_SECRET=
