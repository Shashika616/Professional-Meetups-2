# Copy to `.env` (gitignored — see ../.gitignore) and fill in. docker-compose
# reads this automatically from the same directory (backend/). Never commit
# the real .env.
#
# This only lists what Phase 1 (auth module) actually wires in
# docker-compose.yml today — see docs/plans/00-overview.md. Meetup/billing/
# notification vars (e.g. FIREBASE_SERVICE_ACCOUNT_JSON,
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON) get added here when those phases actually
# wire them into docker-compose.yml, not before.
#
# JWT signing/verification keys and the work-email HMAC key are NOT env
# vars — they're files under backend/secrets/, mounted read-only into the
# containers. See backend/secrets/README.md for how to generate them.

POSTGRES_USER=app
POSTGRES_PASSWORD=app

# From LinkedIn Developer Portal (https://www.linkedin.com/developers/apps) —
# same app/credentials/redirect-URL setup as the sibling microservices repo's
# backend/.env.example describes in full detail; copy its LINKEDIN_* section
# if you're setting this up for the first time and want the complete
# walkthrough (auth-bridge URL requirement, exact-match redirect rules, etc.).
#
# IMPORTANT: these three must exactly match the sibling microservices repo's
# real values if you're reusing the same LinkedIn app (the usual case for
# local dev) — LINKEDIN_CLIENT_ID must also match frontend/.env's
# LINKEDIN_CLIENT_ID, and LINKEDIN_REDIRECT_URI must match
# AppConfig.linkedInRedirectUri (hardcoded in
# frontend/lib/core/config/app_config.dart, not env-driven). A placeholder
# value here (as opposed to the real app's) is exactly what broke LinkedIn
# sign-in on 2026-09-04 — the token exchange checks client_id+client_secret+
# redirect_uri as a matched set, so any mismatch fails closed with no
# obvious error pointing at "wrong .env value."
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://<your-project-id>.web.app

# Notification module (Phase 4, pulled forward — see
# docs/plans/03-hardening-pass.md §E). Raw JSON CONTENT of a downloaded
# Firebase service-account key (Firebase Console -> Project settings ->
# Service accounts -> Generate new private key), not a file path — paste the
# whole downloaded file's content as one line. Leave empty for local
# dev/tests; falls back to a logging sender, same as Twilio/Resend/Gmail
# above. Never existed as a real credential in this repo or the sibling
# microservices repo before 2026-09-04 — this is the actual cause of push
# notifications never having worked in either.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Test-only OTP bypass — see TESTING-NOTES.md. Leave unset/false everywhere
# except your own local .env. When "true", the fixed code 123456 is accepted
# for every OTP purpose IN ADDITION TO the real generated code (never
# instead of it) — purely a manual-testing convenience so you don't have to
# read the real code out of the LoggingSmsSender/LoggingEmailSender log line
# every time. Logs a WARN on every monolith startup while enabled, so it
# can't go unnoticed. Never set this to "true" in any deployed environment.
ALLOW_TEST_OTP_BYPASS=false

# The NARROWER bypass (Plan 16) — a comma-separated allowlist of exact phone
# numbers, matched byte-for-byte against what the client actually sends (no
# normalization). Scoped to phone verification only; email OTP always needs
# the real code. Unlike ALLOW_TEST_OTP_BYPASS above, this one IS set on the
# deployed Cloud Run service, for the two physical test devices whose SMS
# Twilio cannot deliver to yet. Empty/unset = off. See TESTING-NOTES.md.
TEST_OTP_BYPASS_PHONES=

# Sign in with Apple / Google Sign-In audiences (ADR-014 in the sibling
# repo, ported here as auth-module business logic). Leave both empty for
# local dev/tests — those identity providers fail closed (reject every
# token) rather than block startup when unset.
APPLE_SERVICES_ID=
GOOGLE_CLIENT_ID=

# Phone OTP delivery — plain Twilio Programmable Messaging API. Leave empty
# for local dev/tests; falls back to a logging sender (logs the code
# instead of sending).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Personal/corporate/signup email OTP delivery. Gmail SMTP (preferred for
# testing — can send to any recipient, no sandbox restriction) takes
# priority over Resend when both are set. Leave all four empty for local
# dev/tests; falls back to a logging sender, same as SMS above.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Authenticates the gateway->monolith gRPC hop (ADR-001's 2026-09-04
# correction). Every monolith RPC trusts its caller's user_id, which is only
# safe if the gateway is the sole caller; until this existed, that rested
# purely on Docker network isolation rather than on anything the code
# enforced. The two variables below MUST hold the same value — the monolith
# verifies what the gateway sends. docker-compose.yml feeds both from this
# one .env entry so they cannot drift.
#
# Both are REQUIRED: neither process starts without it, and there is
# deliberately no "unset means skip the check" fallback.
#
# Generate a fresh one (never reuse the sibling repo's, or this example's):
#   openssl rand -base64 32
INTERNAL_GRPC_SHARED_SECRET=

# During a ROTATION this may be a comma-separated LIST of secrets the
# monolith accepts, so the gateway can switch over without a coordinated
# restart and without a window where every call fails (§A2). The gateway
# always sends exactly one. Full three-deploy procedure in
# backend/secrets/README.md.
#
#   INTERNAL_GRPC_SHARED_SECRET=<old-secret>,<new-secret>
#
# A trailing comma is rejected at startup rather than quietly adding the
# empty string to the accepted set — which would authenticate any caller.

# --- notification module (Phase 4, pulled forward — docs/plans/03-hardening-pass.md §E) ---
#
# The RAW JSON CONTENT of a Firebase service-account key, not a file path.
# Download it from Firebase Console > Project settings > Service accounts >
# "Generate new private key", then paste the whole file's content here as a
# SINGLE LINE.
#
# Optional, same empty-means-fallback pattern as Twilio/Resend/Gmail: leaving
# it empty selects LoggingPushSender, which logs each notification instead of
# sending it. That is the normal state for local development and for CI — not
# a bypass, just the absence of a credential to talk to FCM with.
#
# A value that is PRESENT but unusable fails the monolith at startup rather
# than silently falling back, because an environment configured to send
# notifications that quietly logs them instead is a failure nobody notices
# until users report missing notifications.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- JWT signing-key rotation (§A3) ---
#
# Public keys from a signing key that has been rotated out but whose access
# tokens may still be in flight. Normally EMPTY — set only for the deploy that
# performs a rotation, then removed once the 15-minute access-token TTL has
# elapsed. Comma-separated. Full procedure in backend/secrets/README.md.
JWT_PREVIOUS_PUBLIC_KEY_PATHS=
