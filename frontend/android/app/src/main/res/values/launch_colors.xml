<?xml version="1.0" encoding="utf-8"?>
<!--
  The window colour Android paints from process start until Flutter's first
  frame. It has to match what that first frame draws, or the app opens with a
  visible flash of the wrong colour.

  These mirror AppPalette.onyx in each theme: #F7F9FA light, #020202 dark. The
  Flutter-generated default was @android:color/white in BOTH, which on a dark
  device meant a white flash before a near-black splash.
-->
<resources>
    <color name="launch_ground">#FFF7F9FA</color>
</resources>
