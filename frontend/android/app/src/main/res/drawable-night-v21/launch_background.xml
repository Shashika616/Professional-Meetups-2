<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch window background. The colour itself is theme-selected via
  values/ and values-night/launch_colors.xml, so this one drawable is correct
  in both and there is no light/dark pair of files to keep in sync.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
</layer-list>
