# Copy to `.env` (gitignored) and fill in as needed. Never commit the real
# `.env` — see frontend/.gitignore.
#
# Consumed via `--dart-define-from-file=.env`:
#
#   flutter run --dart-define-from-file=.env
#   flutter run -d ios --dart-define-from-file=.env
#   flutter build ios --dart-define-from-file=.env
#
# Every key here is read through core/config/app_config.dart's
# String.fromEnvironment(...) calls — add a new AppConfig field alongside
# any new key you add here. A one-off override still works too:
# `--dart-define=KEY=value` takes precedence over the same key in this
# file, no need to edit .env for a single throwaway run.

# Gateway base URL — must match your run target (backend/README.md's
# documented gotcha): http://localhost:8080 for the iOS simulator,
# http://10.0.2.2:8080 for the Android emulator (its alias for the host
# machine's localhost). AppConfig defaults to the iOS-simulator value if
# this is left unset, so it's optional for the common case.
GATEWAY_BASE_URL=http://localhost:8080

# LinkedIn's public OAuth client ID (not a secret — only
# LINKEDIN_CLIENT_SECRET, held solely by backend/services/auth, is). Must
# match backend/.env's LINKEDIN_CLIENT_ID. AppConfig has a working default
# baked in, so this is optional unless that value ever changes.
LINKEDIN_CLIENT_ID=

# Stadia Maps API key. Only read when MAP_PROVIDER=stadia (below); the
# default OSM provider needs no key at all. With MAP_PROVIDER=stadia and
# this empty, the location step shows a "not configured" message instead
# of a broken map. Free keys: https://client.stadiamaps.com
STADIA_MAPS_API_KEY=

# Android map/geocoding provider: osm (default; OpenFreeMap tiles + Photon
# search, OpenStreetMap-based, no key, no metering) or stadia (the previous
# provider; requires STADIA_MAPS_API_KEY). iOS always uses Apple Maps.
MAP_PROVIDER=osm
